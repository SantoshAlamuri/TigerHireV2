# Copy values into .env.local (do not commit real addresses).
# Then: node --env-file=.env.local scripts/seed-notification-fixtures.mjs

# --- Candidates (JSON array, max 3) ---
# NOTIFICATION_TEST_FIXTURES='[{"email":"you1@example.com","phone":"919876543210","fullName":"QA One"},{"email":"you2@example.com","phone":"919876543211","fullName":"QA Two"}]'

# --- Or use numbered slots ---
# NOTIFICATION_TEST_EMAIL_1=you1@example.com
# NOTIFICATION_TEST_PHONE_1=919876543210
# NOTIFICATION_TEST_NAME_1=QA One
#
# NOTIFICATION_TEST_EMAIL_2=you2@example.com
# NOTIFICATION_TEST_PHONE_2=919876543211
# NOTIFICATION_TEST_NAME_2=QA Two

# --- Optional: recruiter inbox for recruiter-facing emails ---
# NOTIFICATION_TEST_RECRUITER_EMAIL=recruiter@example.com
# NOTIFICATION_TEST_RECRUITER_NAME=QA Recruiter

# SEED_DEMO_PASSWORD=ChooseAStrongTempPassword
