{
  "name": "tigerhire",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "predev": "node scripts/assert-package-json.mjs",
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "prebuild": "node scripts/assert-package-json.mjs && node scripts/remove-dev-routes.mjs",
    "build": "next build",
    "postbuild": "node scripts/restore-dev-routes.mjs",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "seed:admin": "node --env-file=.env.local scripts/seed-platform-admin.mjs",
    "grant-platform-admin": "npx tsx --env-file=.env.local scripts/grant-platform-admin.ts",
    "seed:finstack": "node scripts/seed-finstack.mjs",
    "seed:tour-demo": "node --env-file=.env.local scripts/seed-tour-demo.mjs",
    "seed:notify-fixtures": "node --env-file=.env.local scripts/seed-notification-fixtures.mjs",
    "seed:referral": "npx tsx scripts/seed-referral-demo.ts",
    "backfill:referrals-candidate-id": "npx tsx --env-file=.env.local scripts/backfill-referrals-candidate-id.ts",
    "create:templates": "npx tsx --env-file=.env.local scripts/create-whatsapp-templates.ts",
    "whatsapp:submit-plan-templates": "node --env-file=.env.local scripts/submit-plan-whatsapp-templates.mjs",
    "lint": "eslint --no-warn-ignored src tests scripts *.ts *.mjs",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:strict": "VITEST_ENFORCE_COVERAGE=1 vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:agency-candidates": "vitest run --config vitest.agency-candidates.config.ts",
    "test:agency-candidates:coverage": "vitest run --config vitest.agency-candidates.config.ts --coverage",
    "test:functional": "vitest run tests/functional",
    "test:stability": "vitest run tests/regression tests/performance",
    "test:stress": "vitest run tests/stress",
    "test:perf": "vitest run tests/performance",
    "test:integration": "vitest run tests/integration",
    "test:component": "vitest run tests/component",
    "test:critical": "node scripts/run-verification-bundle.mjs critical",
    "test:ga-sweep": "node scripts/run-verification-bundle.mjs ga-sweep",
    "test:intake-channels": "vitest run tests/unit/email-intake-route.test.ts tests/unit/webhooks-whatsapp-route.test.ts tests/unit/parse-webhook-payload.test.ts tests/unit/apply-routes.test.ts tests/unit/whatsapp-flow-status-route.test.ts tests/unit/whatsapp-application-bridge.test.ts tests/unit/whatsapp-inbound-intent.test.ts",
    "test:release-gate": "npm run test:ga-sweep",
    "test:all": "vitest run",
    "test:e2e": "playwright test --project=smoke",
    "test:e2e:release": "playwright test --config playwright.release.config.ts && node scripts/check-release-e2e.mjs",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:pilot": "playwright test --project=pilot",
    "test:e2e:full": "playwright test",
    "pilot:pretest": "node --env-file=.env.local scripts/pilot-pretest-setup.mjs",
    "pilot:seed": "npx tsx --env-file=.env.local scripts/pilot-seed-lifecycle-data.ts",
    "email:test-all": "npx tsx --env-file=.env.local scripts/send-all-notification-emails.ts",
    "pilot:db-check": "node --env-file=.env.local scripts/pilot-db-assertions.mjs",
    "test:e2e:tour": "playwright test e2e/tour-recording.spec.ts --project=full",
    "verify:rate-limits": "node scripts/verify-rate-limits.mjs",
    "plan:beta-env": "node scripts/print-plan-beta-env.mjs",
    "release-gate:dev": "node scripts/release-gate-dev.mjs",
    "e2e:sync-apply-slug": "node --env-file=.env.local scripts/set-e2e-apply-slug.mjs",
    "k6:load": "k6 run k6/load-test.js",
    "k6:stress": "k6 run k6/stress-test.js",
    "k6:spike": "k6 run k6/spike-test.js",
    "k6:soak": "k6 run k6/soak-test.js",
    "k6:benchmark": "k6 run k6/api-benchmark.js",
    "k6:breakpoint": "k6 run k6/breakpoint-test.js",
    "k6:auth": "k6 run k6/authenticated-flow.js",
    "format": "prettier --write .",
    "format:check": "prettier --check --ignore-unknown \"src\" \"tests\" \"scripts\" \"e2e\" \"docs\" \"*.{json,md,ts,tsx,mjs,mts}\"",
    "prepare": "husky",
    "db:push": "supabase db push",
    "gen:types": "node scripts/gen-supabase-types.mjs",
    "apply:auth-templates": "node scripts/apply-supabase-auth-email-templates.mjs",
    "send-test-auth-email": "node scripts/send-test-auth-email.mjs",
    "send-test-resend-samples": "npx tsx scripts/send-test-resend-samples.ts",
    "send-test-whatsapp": "node --env-file=.env.local scripts/send-test-whatsapp.mjs",
    "backfill:hybrid-after-jd-approval": "NODE_OPTIONS='--conditions=react-server' npx tsx --env-file=.env.local scripts/backfill-hybrid-after-jd-approval.ts",
    "diagnostic:hybrid-path-mix": "npx tsx --env-file=.env.local scripts/hybrid-path-mix-diagnostic.ts",
    "review:verdict-card": "npx tsx --env-file=.env.local scripts/review-verdict-card.ts",
    "migration:new": "supabase migration new",
    "mcp:supabase": "npx -y @supabase/mcp-server-supabase",
    "rate": "node scripts/elite-audit.mjs",
    "rate:ci": "node scripts/elite-audit.mjs --fail-under=70",
    "validate": "node scripts/validate-schemas.mjs",
    "size-check": "node scripts/size-check.mjs",
    "security-audit": "npm audit --audit-level=high",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@4.2.1 --ignore-npm-errors --output-file sbom.json",
    "check:inngest-registration": "node scripts/check-inngest-registration.mjs",
    "gate": "npm run typecheck && npm run lint -- --max-warnings 0 && npm run format:check && node scripts/validate-schemas.mjs && node scripts/size-check.mjs && npm run check:inngest-registration",
    "gate:release": "npm run typecheck && npm run lint -- --max-warnings 0 && npm run check:inngest-registration && node scripts/audit-api-routes.mjs",
    "security:safety-check": "node scripts/security-safety-check.mjs",
    "launch:enterprise-ready": "node scripts/launch-enterprise-ready.mjs",
    "whatsapp:verify-webhook": "node --env-file=.env.local scripts/whatsapp-verify-webhook.mjs",
    "whatsapp:diagnose-outbound": "node scripts/diagnose-whatsapp-outbound.mjs",
    "whatsapp:verify-waba": "node scripts/verify-whatsapp-waba.mjs",
    "test:whatsapp-flow": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.whatsapp-flow.config.ts",
    "audit:auth-parity": "node scripts/auth-parity-matrix.mjs",
    "audit:auth-parity:strict": "node scripts/auth-parity-matrix.mjs --fail-on-findings",
    "launch:readiness:auto": "node scripts/launch-readiness-auto.mjs",
    "v2:gaps": "node scripts/v2-gap-report.mjs",
    "schema-drift-check": "node scripts/schema-drift-check.mjs",
    "schema-drift-report": "node scripts/schema-drift-check.mjs --report",
    "verify:boot": "node scripts/verify-server-boot.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "npx prettier --write",
      "npx eslint --fix"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.110.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "10.2.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@sentry/nextjs": "10.63.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.0",
    "@tiptap/extension-highlight": "^3.27.2",
    "@tiptap/extension-link": "^3.27.2",
    "@tiptap/extension-placeholder": "^3.27.2",
    "@tiptap/extension-text-align": "^3.27.2",
    "@tiptap/extension-underline": "^3.27.2",
    "@tiptap/pm": "^3.27.2",
    "@tiptap/react": "^3.27.2",
    "@tiptap/starter-kit": "^3.27.2",
    "@upstash/redis": "1.38.0",
    "@vercel/analytics": "^2.0.1",
    "buffer": "^6.0.3",
    "geist": "1.7.2",
    "inngest": "^4.11.0",
    "js-cookie": "3.0.8",
    "lucide-react": "1.23.0",
    "mammoth": "1.12.0",
    "nanoid": "^5.1.16",
    "next": "16.3.5",
    "openai": "^6.45.0",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "2.4.5",
    "posthog-js": "1.396.8",
    "razorpay": "^2.9.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.2",
    "resend": "6.17.1",
    "server-only": "^0.0.1",
    "stripe": "22.3.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "lodash": "^4.18.1",
    "protobufjs": "^7.5.6",
    "@xmldom/xmldom": "^0.9.10",
    "dompurify": "^3.4.2",
    "next": {
      "postcss": "^8.5.22",
      "sharp": "^0.35.3"
    },
    "postcss": "^8.5.22"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/js-cookie": "3.0.6",
    "@types/node": "^25",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/coverage-v8": "4.1.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "tailwindcss": "4",
    "typescript": "6",
    "vitest": "4.1.5"
  }
}
