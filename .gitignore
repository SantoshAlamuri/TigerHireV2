# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/e2e/.pilot-seed-cache.json
/blob-report/
vitest-integration-report.json

# next.js
/.next/
/out/
.dev-routes-backup/

# production
/build

# misc
sbom.json
.DS_Store
*.pem
.tsbuildinfo.typecheck

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cursor
.cursor/

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA build artifacts (generated by @ducanh2912/next-pwa)
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/fallback-*.js
public/workbox-*.js

# Claude Flow (local use only)
.claude/
.claude-flow/
CLAUDE.md
.mcp.json

# local cookie/curl data
cookies.txt

# docx reference / extracts (keep local only)
TigerHire_v3.docx.zip
docx_extract/

# database backups (contain PII)
/backups/

# Local scoring run artifacts (committed comparison fixtures under scripts/output/ stay tracked)
scripts/output/*
!scripts/output/qa-engineer-scoring-comparison-*
!scripts/output/qa-engineer-scoring-run.log
!scripts/output/qa-engineer-rescore-run.log

# ephemeral MCP migration payloads (generated locally)
/mcp/compact*.json
/mcp/*-payload.json
/mcp/exec*.json
/mcp/out-*.json
