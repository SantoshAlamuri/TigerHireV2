# TigerHire — copy to .env.local and fill in values.
# Dev: use a separate Supabase project (or Branching). Production: set these in Vercel.
#
# RULES: No space around =. No quotes unless value has spaces. Restart dev server after changes.

# --- Required (production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: proxy Supabase behind your domain (tigerhire.io) so auth/API URLs stay on your site ---
# Set NEXT_PUBLIC_SUPABASE_URL to your app origin (e.g. https://tigerhire.io) and SUPABASE_INTERNAL_URL to the real Supabase URL (e.g. https://your-project.supabase.co). See docs/SUPABASE_AUTH_CONNECTIVITY_INDIA.md.
# SUPABASE_INTERNAL_URL=
# Optional fallback URL used by some local scripts.
# SUPABASE_URL=
# Skip browser-side local fetch fallback checks in dev (debug only).
# NEXT_PUBLIC_SUPABASE_SKIP_DEV_FETCH=1

# --- Cron Authentication (REQUIRED for cron jobs) ---
# For LOCAL DEV: You can set CRON_SECRET (plain text is fine for local)
# For PRODUCTION: Use ONLY CRON_SECRET_HASH (never set CRON_SECRET in production)
# 
# Generate hash from secret:
#   node -e "console.log(require('crypto').createHash('sha256').update('your-secret-here').digest('hex'))"
#
# Or generate a new secret + hash:
#   node -e "const s=require('crypto').randomBytes(32).toString('hex'); const h=require('crypto').createHash('sha256').update(s).digest('hex'); console.log('CRON_SECRET='+s); console.log('CRON_SECRET_HASH='+h)"
#
# Production setup in Vercel:
#   1. Generate secret + hash (use command above)
#   2. Set CRON_SECRET_HASH in Vercel environment variables
#   3. Use the hash value in your cron job scheduler (Vercel Cron, external scheduler, etc.)
#   4. NEVER set CRON_SECRET in production (system will warn if detected)
CRON_SECRET=
CRON_SECRET_HASH=

# --- App URL (no trailing slash) ---
NEXT_PUBLIC_APP_URL=https://tigerhire.io

# --- Optional: company admin first-login banner + pending-activation page (tel: link uses digits after +) ---
NEXT_PUBLIC_COMPANY_ONBOARDING_PHONE=+917674911055

# --- Optional: Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: Razorpay (Razorpay-first billing rollout) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional plan mapping for DB fallback:
# RAZORPAY_PLAN_STARTER=plan_xxx
# RAZORPAY_PLAN_GROWTH=plan_xxx
# RAZORPAY_PLAN_SCALE=plan_xxx
# RAZORPAY_PLAN_CANDIDATE_PRO=plan_xxx
# Provider routing controls:
# - BILLING_DEFAULT_PROVIDER=razorpay enables Razorpay-first checkout path.
# - BILLING_FORCE_STRIPE=true is an emergency kill switch for new checkouts.
BILLING_DEFAULT_PROVIDER=razorpay
# BILLING_FORCE_STRIPE=false
# Optional enterprise exception: comma-separated organisation IDs that can use manual
# unlock wallet credits even after monthly plan cap is reached.
# MANUAL_UNLOCK_CAP_BYPASS_ORG_IDS=org_uuid_1,org_uuid_2

# --- Optional: Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@app.tigerhire.io
# Transactional HTML emails load the logo from a public HTTPS URL (Gmail cannot fetch localhost). If
# NEXT_PUBLIC_APP_URL is http://localhost:... the logo defaults to https://tigerhire.io/logo-light.svg
# unless you set EMAIL_LOGO_BASE_URL or a full file URL for EMAIL_BRAND_LOGO_URL (PNG is most compatible).
# EMAIL_LOGO_BASE_URL=https://tigerhire.io
# EMAIL_BRAND_LOGO_URL=https://tigerhire.io/logo-light.svg
# Beta: use re_test_... key (Resend accepts, no delivery). Or EMAIL_MODE=sandbox to skip Resend entirely.
# EMAIL_MODE=sandbox
#
# Production (Vercel VERCEL_ENV=production): omit or leave false until you want real email + WhatsApp.
# Without this on production, outbound WhatsApp/email are log-only (see postMetaMessage OUTBOUND_HOLD).
# OUTBOUND_NOTIFICATIONS_ENABLED=true

# --- Optional: AI (for JD parsing, FitScore, etc.) ---
# Key must be from the same Anthropic org you added credits to (console.anthropic.com → API keys).
# If you see "credit balance too low" after paying: use a key from the org that has balance; restart dev server.
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_API_KEY=
# Legacy alias still supported by env reader:
# ANTHROPIC_KEY=
# Optional: JD parse/generate model. Default is Sonnet (cheaper). Set to claude-opus-4-6 for highest quality (higher cost).
# ANTHROPIC_JD_MODEL=claude-opus-4-6
# OpenAI: Used for FitScore Stage 2A structured extraction (two-model approach). Get key at platform.openai.com.
OPENAI_API_KEY=
# Enable hybrid Stage 2 (extract facts with OpenAI, then grade with Claude). Required for OpenAI extraction.
# USE_HYBRID_STAGE2=true
# Optional: enable OpenAI in FitScore extraction path.
# OPENAI_FITSCORE_ENABLED=true
# --- FitScore hybrid scoring (May 2026 defaults — see docs/SCORING_ARCHITECTURE.md) ---
# Primary extraction + merged verdict model. Default: Sonnet 4.6 (alias resolves to latest snapshot).
FITSCORE_HYBRID_MODEL=claude-sonnet-4-6
# FITSCORE_HYBRID_HAIKU_MODEL=claude-haiku-4-5-20251001
# FITSCORE_HYBRID_EXPLANATION_MODEL=claude-sonnet-4-6
# One Sonnet call for extraction + verdict (recommended production).
FF_MERGED_EXTRACTION_VERDICT=true
# Max attempts when merged JSON fails (fixed at 1 in src/lib/fitscore/hybrid/constants.ts — documented here for operators).
# MERGED_EXTRACTION_MAX_ATTEMPTS=1
# Primary FitScore = 25% skills + 75% intent; TriBlend preserved in shadow_score.
FF_FITSCORE_BLEND_V2=true
NEXT_PUBLIC_FF_FITSCORE_BLEND_V2=true
# Resume parse: tier 1 pdfjs/DOCX/text must reach this length before tier 2/3 (default 2000).
RESUME_PARSE_MIN_CHARS=2000
# Tier 2 Haiku text enrichment when tier 1 is short. Code default on unless "false".
FF_CV_PARSER_HAIKU_ENABLED=true
# Tier 3 Sonnet vision on PDF. Code default on if unset; set false in prod to avoid vision spend.
FF_VISION_FALLBACK_ENABLED=false
# Regex/signal scoring when merged Sonnet JSON fails. Code default on unless "false".
FF_DETERMINISTIC_FALLBACK_ENABLED=true
# Per-call cache token diagnostics (staging/scripts; optional in prod).
FITSCORE_SCORING_DIAGNOSTIC=true
# Optional Anthropic Admin API key for usage/cost tooling scripts.
# ANTHROPIC_ADMIN_API_KEY=

# --- Optional: FitScore v2 peer review (Sonnet first, Opus second pass when score in band) ---
# FITSCORE_PEER_REVIEW_ENABLED=true
# FITSCORE_PEER_REVIEW_BAND_MIN=40
# FITSCORE_PEER_REVIEW_BAND_MAX=92
# FITSCORE_PEER_REVIEW_DIVERGENCE_THRESHOLD=15
# FITSCORE_HUMAN_REVIEW_SCORE_BAND=70,75
# Hybrid v2 recruiter-facing rollout switches:
# Set to false to hide these UI/API fields without disabling hybrid scoring itself.
# FF_VERDICT_CV_EVIDENCE=true
# FF_CONFIDENCE_BAND=true
# NEXT_PUBLIC_FF_VERDICT_CV_EVIDENCE=true
# NEXT_PUBLIC_FF_CONFIDENCE_BAND=true
# Interview scheduling: link interviewers to org profiles + round ladder (see migration
# `supabase/migrations/20260513120000_pipeline_stages_interviewer_user_id.sql`).
#
# IMPORTANT — flip server + client flags together in each environment (especially production):
# - `FF_INTERVIEWER_IDENTITY_V1` gates server behaviour (POST validation for interview-like stages,
#   and GET `/api/jobs/[id]/interviewer-profile-options`).
# - `NEXT_PUBLIC_FF_INTERVIEWER_IDENTITY_V1` gates client UI (pipeline stage picker, candidate
#   round ladder). If only one is true, the UI and API disagree (hidden picker vs enforced
#   validation, or an API 404 for the picker while the UI expects it).
# Non-production: both default ON unless set to "false". Production: both must be "true" to enable.
# FF_INTERVIEWER_IDENTITY_V1=true
# NEXT_PUBLIC_FF_INTERVIEWER_IDENTITY_V1=true
#
# Brief 11/12: plan-first job workspace + auto-execution on stage entry (requires both for Phase C).
# Brief 11/12: enable for local dev (plan page, default recruitment plan in Setup).
FF_PLAN_DOCUMENT=true
NEXT_PUBLIC_FF_PLAN_DOCUMENT=true
# FF_PLAN_AUTO_EXECUTE=true
# NEXT_PUBLIC_FF_PLAN_AUTO_EXECUTE=true
#
# After applying the migration on an environment, run this in SQL and paste linked/unlinked/total
# into the PR description (sanity-check backfill before merging to dev/prod):
#   SELECT
#     COUNT(*) FILTER (WHERE interviewer_user_id IS NOT NULL) AS linked,
#     COUNT(*) FILTER (WHERE interviewer_user_id IS NULL) AS unlinked,
#     COUNT(*) AS total
#   FROM pipeline_stages;
# Optional — inspect naming vs enum (find mis-typed interview rounds):
#   SELECT stage_type, stage_name, COUNT(*) FROM pipeline_stages GROUP BY 1, 2 ORDER BY 3 DESC;
# Rescore after v2 rollout: delete old fit_scores for affected candidates (or all), then re-run scoring
# (e.g. agency pipeline "Re-upload CV to score" or POST /api/fit-score for candidate re-run).

# --- Optional: WhatsApp via Meta Cloud API ---
# Meta: App Dashboard -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Optional Graph version override for template/audit scripts.
# WHATSAPP_GRAPH_VERSION=v22.0
# Webhook GET verify token (hub.verify_token) — same string you enter in Meta webhook "Verify token".
WHATSAPP_WEBHOOK_SECRET=
# Meta POST signature: App Dashboard → App settings → Basic → App secret (x-hub-signature-256). Optional; if empty, WHATSAPP_WEBHOOK_SECRET is used (legacy/BSP).
# WHATSAPP_META_APP_SECRET=
# npm run create:templates — template utility script for Meta/legacy compatibility.
# Customer-facing number for website wa.me links (footer, contact, waitlist). E.164, optional +.
# NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=+919880444688
# Beta: log only, no WhatsApp sends.
# WHATSAPP_MODE=sandbox
# Optional: name of a Meta-approved referral-invite template that carries the job
# apply LINK + company name (params: candidateName, referrerFirstName, jobTitle,
# companyName, applyUrl). When set, employee referral WhatsApp invites use it so
# the referred candidate gets a clickable apply link. Until approved + set, invites
# fall back to th_application_received with the real company name + job title.
# WHATSAPP_REFERRAL_INVITE_TEMPLATE=th_referral_invite_v1
# Optional: if users sometimes enter 10-digit local numbers without country code (e.g. India),
# set digits-only ITU calling code so Meta `to` is still international. Example: 91
# WHATSAPP_OTP_DEFAULT_COUNTRY_CODE=91
# Optional: comma-separated user ids to notify for WhatsApp human handovers.
# If empty, TigerHire falls back to active super_admin users.
# WHATSAPP_HANDOVER_NOTIFY_USER_IDS=uuid-1,uuid-2
# Pre-screening link template: must match approved Meta template name; body param count/order must still match code.
# WHATSAPP_SCREENING_TEMPLATE_NAME=screening_questions

# --- Optional: Screening v1 (voice add-on) ---
# Bolna API credentials for outbound voice screening.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional but recommended: force outbound caller ID (E.164) to your purchased number.
# If unset, Bolna may use a shared/default number pool.
BOLNA_FROM_PHONE_NUMBER=
BOLNA_WEBHOOK_SECRET=
# Optional fallback shared secret sent via custom header x-tigerhire-webhook-secret.
BOLNA_WEBHOOK_FALLBACK_SECRET=
# Internal COGS (INR per billed minute, ceil(duration/60)) stored on screening_jobs.cost_inr on call completion.
# WhatsApp admin totals are unrelated (Meta Graph sync). Default 6 if unset.
# BOLNA_INTERNAL_COST_INR_PER_MINUTE=6
# Optional dedicated bearer for monthly screening billing cron endpoint.
SCREENING_BILLING_CRON_SECRET=

# --- Optional: Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: Apify ---
APIFY_API_TOKEN=

# --- Optional: Job Board Credentials Encryption ---
# Generate ONCE with: openssl rand -hex 32
# This is the master encryption key used to encrypt/decrypt all company credentials
# Required if using per-organisation job board credentials (tenant isolation)
# IMPORTANT: Generate this ONCE and keep it secure. Do NOT regenerate it or you'll lose access to encrypted credentials.
JOB_BOARD_CREDENTIALS_ENCRYPTION_KEY=

# --- Optional: Job Board Global Fallback (MIGRATION ONLY) ---
# Set to "true" ONLY during migration period to allow fallback to global env vars
# Once all companies have configured their own credentials, set to "false" or remove
# In production, this should be "false" or unset to enforce tenant isolation
ALLOW_JOB_BOARD_GLOBAL_FALLBACK=false

# --- Optional: Job Distribution (Indeed) ---
# Indeed Job Sync API access token (OAuth Bearer token).
# Requires signing up as a Publisher at indeed.com/publisher and obtaining OAuth credentials.
# The access token should be refreshed externally. For production, implement token refresh mechanism.
INDEED_ACCESS_TOKEN=
# Optional: Adzuna connector credentials (required only when Adzuna distribution is enabled).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jobs v2 external source APIs
RAPIDAPI_KEY=
# Optional dedicated auth for /api/jobs/sync (cron Bearer via CRON_SECRET also works)
SYNC_SECRET=
# Aggregated jobs are written under this system org (preferred: explicit UUID)
JOBS_AGGREGATED_ORG_ID=
# Fallback slug lookup if JOBS_AGGREGATED_ORG_ID is unset
JOBS_AGGREGATED_ORG_SLUG=tigerhire-aggregated

# --- Optional: Identity/SSO and SCIM ---
# Bearer secret for Entra sync route.
ENTRA_SYNC_SECRET=
# OAuth tenant for Microsoft auth (default "common").
# MICROSOFT_OAUTH_TENANT=common
# SCIM bearer token (single token mode).
# SCIM_BEARER_TOKEN=
# SCIM bearer tokens as JSON map (multi-token mode). Example: {"tokenA":"integration-a"}
# SCIM_BEARER_TOKENS_JSON=

# --- Optional: Integration secret management ---
# Encryption key for integration secrets at rest.
# Generate once: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# --- Optional: Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Slack incoming webhook for alert forwarding.
# SLACK_WEBHOOK_URL=

# --- Optional: Workflow/queue and feature tuning ---
# Inngest event key for job enqueueing.
INNGEST_EVENT_KEY=
# Inngest signing key: authenticates Inngest Cloud -> /api/inngest invocations
# and the deploy-time sync handshake. Required in prod alongside the event key.
INNGEST_SIGNING_KEY=
# DEBUG_CACHE=1
# WAITLIST_COUNT_SEED=0
# APPLICATION_COOLING_OFF_DAYS=14
# REFERRAL_LINK_TTL_DAYS=30
# REFERRAL_DAILY_CAP=20
# REFERRAL_TARGET_DEDUP_WINDOW_HOURS=24
# REFER_OTP_SEND_PHONE_LIMIT=3
# REFER_OTP_SEND_PHONE_WINDOW_SECS=3600
# REFER_OTP_SEND_IP_LIMIT=20
# REFER_OTP_SEND_IP_WINDOW_SECS=60
# TOP_MATCHES_LIMIT=3
# FITSCORE_MIN_CONFIDENCE=0.6
# FITSCORE_MIN_SKILLS=3
# SCOUT_JOBS_LIMIT=20
# HIDDEN_PUBLIC_JOB_ORG_SLUGS=finstack,talentbridge

# --- Optional: Offer/public-link security ---
# HMAC secret used for public offer link signing (recommended to set explicitly in prod).
# OFFER_PUBLIC_LINK_SECRET=
# Optional deep-link secret; defaults to OFFER_PUBLIC_LINK_SECRET when omitted.
# APPROVAL_DEEP_LINK_SECRET=
# B8 emergency only: allow creating offer drafts when the job has no approved/linked hiring requisition.
# OFFER_SKIP_HIRING_REQUEST_LINK_GATE=true

# --- Optional: Orchestrator watchdog ---

# --- Optional: SpringVerify integration ---
SPRINGVERIFY_API_KEY=
SPRINGVERIFY_CREATE_CASE_URL=
SPRINGVERIFY_WEBHOOK_SECRET=

# --- Optional: idibu job board integration ---
# --- Optional: idibu (prefer Company Settings → Job boards UI per organisation) ---
# Platform env fallback only when ALLOW_JOB_BOARD_GLOBAL_FALLBACK=true or no org UI config.
# IDIBU_WEBHOOK_SECRET=          # shared secret for POST /api/webhooks/idibu (legacy platform URL)
# IDIBU_APP_ID=                  # idibu developer app id
# IDIBU_APP_SECRET=              # idibu developer app secret (server-side only)
# IDIBU_INTEGRATION_NAME=tigerhire
# IDIBU_DEFAULT_SECTOR=1         # fallback sector when role_category is unmapped

# --- Optional: Platform cost + management scripts ---
# SUPABASE_MANAGEMENT_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_USD_PER_MILLION_REQUESTS=2.5
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_TEAM_SLUG=

# --- Optional: Local dev seed protection ---
# Secret for protected demo seed routes in development/staging.
# SEED_DEMO_SECRET=

# --- Optional: Preview test-login (/api/auth/test-login) ---
# Local dev (localhost) always allows test-login; production is always 404.
# On a preview/staging deploy it stays OFF unless you opt in explicitly AND
# configure a secondary control (a request must satisfy one of them):
#   TEST_LOGIN_ENABLED=true            # explicit opt-in for non-prod deploys
#   TEST_LOGIN_SECRET=                 # require header `x-test-login-secret: <value>`
#   TEST_LOGIN_ALLOWED_IPS=            # comma-separated client IP allowlist
# With TEST_LOGIN_ENABLED=true but neither control set, the endpoint refuses (404).

# --- Pilot exhaustive E2E (see .env.pilot-e2e.example) ---
# Copy .env.pilot-e2e.example → .env.pilot-e2e.local and set PILOT_PHONE_* for WhatsApp tests.
# npm run pilot:pretest && npm run test:e2e:pilot

# --- Playwright E2E (local + optional CI): org slug for /apply/{slug} tests ---
# Must match an organisation.slug in your Supabase. Default in tests is "razorpay" if unset.
# E2E_APPLY_ORG_SLUG=razorpay
# Auto-pick from DB and write to .env.local: npm run e2e:sync-apply-slug
# CI enforcement toggle for live Supabase integration tests.
# REQUIRE_LIVE_SUPABASE_INTEGRATION=true

# --- Dev only: never set in production ---
# NEXT_PUBLIC_SHOW_TEST_ACCOUNTS=true

# --- Tryout demo app (tryout.tigerhire.io) ---
# UUID of the dedicated tryout organisation; required for /api/tryout/* routes.
# TRYOUT_ORG_ID=
# Extra CORS origins (comma-separated). Defaults include tryout.tigerhire.io and localhost:3001.
# TRYOUT_ALLOWED_ORIGINS=
